generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Admin-managed product types (Flex Desk, Fixed Desk, Dedicated Cabin, etc.)
/// Replaces the old ProductType enum — add/rename/retire types without migrations.
model ProductType {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  displayName String
  slug        String    @unique
  description String?   @db.Text
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  supportTickets SupportTicket[]
}

/// Admin-managed billing durations (Per Hour, Per Day, Per Month, etc.)
/// Replaces the old DurationType enum.
model DurationType {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  displayName   String
  slug          String        @unique
  durationDays  Int?
  durationHours Int?
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  bookings      Booking[]
  pricingPlans  PricingPlan[]
}

/// Admin-managed space categories (Workspace, Guest Space, etc.)
/// Replaces the old SpaceCategory enum.
model SpaceCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  displayName String
  slug        String    @unique
  description String?   @db.Text
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

/// Admin-managed access-time options (Business Hours, 24/7, Custom)
/// Replaces the old AccessTime enum.
model AccessTimeOption {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  displayName String
  startTime   String?
  endTime     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

/// Admin-managed ticket statuses (Open, In Progress, Resolved, Closed, etc.)
/// Replaces the old TicketStatus enum.
model TicketStatus {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  displayName String
  color       String?
  isFinal     Boolean         @default(false)
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tickets     SupportTicket[]
}

/// Admin-managed booking statuses (Pending, Confirmed, Active, Completed, Cancelled)
model BookingStatus {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  displayName String
  color       String?
  isFinal     Boolean   @default(false)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
}

/// Admin-managed payment statuses (Pending, Partial, Paid, Refunded, Failed)
model PaymentStatus {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  displayName String
  color       String?
  isFinal     Boolean   @default(false)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]
}

/// Internal admin/staff users who manage the platform.
model User {
  id                Int             @id @default(autoincrement())
  name              String
  email             String          @unique
  password          String
  phone             String?
  contactNumber     String?
  companyName       String?
  companyStreet     String?         @db.Text
  companyCity       String?
  companyState      String?
  companyZip        String?
  designation       String?
  avatar            String?
  isActive          Boolean         @default(true)
  roleId            Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  activityLogs      ActivityLog[]
  supportTickets    SupportTicket[] @relation("TicketAssignee")
  role              Role            @relation(fields: [roleId], references: [id])
  assignedLocations UserLocation[]

  @@index([email])
  @@index([roleId])
}

/// Roles are fully dynamic — admin creates them at runtime (Admin, Manager, etc.)
model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  displayName String
  description String?          @db.Text
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

/// Permissions are fully dynamic — admin defines granular access controls.
model Permission {
  id          Int              @id @default(autoincrement())
  module      String
  action      String
  name        String           @unique
  displayName String
  description String?          @db.Text
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       Int
  permissionId Int
  assignedAt   DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

/// External customers — businesses or freelancers who rent your spaces.
model Customer {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  phone          String?
  organization   String?
  gstNumber      String?
  billingAddress String?         @db.Text
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bookings       Booking[]
  supportTickets SupportTicket[]

  @@index([email])
  @@index([phone])
}

model City {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  slug      String     @unique
  state     String?
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  locations Location[]
}

model Location {
  id             Int                     @id @default(autoincrement())
  cityId         Int
  name           String
  slug           String                  @unique
  area           String?
  address        String?                 @db.Text
  mapUrl         String?                 @db.Text
  mapEmbed       String?                 @db.Text
  phone          String?
  email          String?
  gstNumber      String?
  isActive       Boolean                 @default(true)
  sortOrder      Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  city           City                    @relation(fields: [cityId], references: [id])
  images         LocationImage[]
  operatingHours LocationOperatingHour[]
  products       Product[]
  assignedUsers  UserLocation[]
  supportTickets SupportTicket[]

  @@index([cityId])
  @@index([slug])
}

/// Per-location operating hours (so each branch can have different timings).
model LocationOperatingHour {
  id         Int      @id @default(autoincrement())
  locationId Int
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isClosed   Boolean  @default(false)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
  @@index([locationId])
}

model LocationImage {
  id         Int      @id @default(autoincrement())
  locationId Int
  url        String
  alt        String?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

/// Many-to-many: which staff users are assigned to which locations.
model UserLocation {
  userId     Int
  locationId Int
  assignedAt DateTime @default(now())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@index([userId])
  @@index([locationId])
}

/// A bookable space at a specific location.
model Product {
  id                        Int               @id @default(autoincrement())
  locationId                Int
  typeId                    Int
  categoryId                Int
  accessTimeId              Int?
  name                      String
  slug                      String
  description               String?           @db.Text
  capacity                  Int?
  quantity                  Int               @default(1)
  securityDepositMonths     Int               @default(3)
  complementaryMeetingHours Int?
  sdr                       Int?
  adv                       Int?
  isActive                  Boolean           @default(true)
  isFeatured                Boolean           @default(false)
  sortOrder                 Int               @default(0)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  bookings                  Booking[]
  pricingPlans              PricingPlan[]
  accessTime                AccessTimeOption? @relation(fields: [accessTimeId], references: [id])
  category                  SpaceCategory     @relation(fields: [categoryId], references: [id])
  location                  Location          @relation(fields: [locationId], references: [id])
  type                      ProductType       @relation(fields: [typeId], references: [id])
  amenities                 ProductAmenity[]
  images                    ProductImage[]

  @@unique([locationId, slug])
  @@index([locationId])
  @@index([typeId])
  @@index([categoryId])
  @@index([accessTimeId], map: "Product_accessTimeId_fkey")
}

/// Pricing per product × duration combination.
/// e.g. Dedicated Cabin at Mercado → Per Month → ₹11,000
model PricingPlan {
  id             Int          @id @default(autoincrement())
  productId      Int
  durationTypeId Int
  price          Decimal      @db.Decimal(10, 2)
  oldPrice       Decimal?     @db.Decimal(10, 2)
  discount       Decimal?     @db.Decimal(5, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  durationType   DurationType @relation(fields: [durationTypeId], references: [id])
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, durationTypeId])
  @@index([productId])
  @@index([durationTypeId])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Amenities are fully dynamic — admin creates them.
model Amenity {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  slug        String           @unique
  icon        String?
  description String?          @db.Text
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  products    ProductAmenity[]
}

model ProductAmenity {
  productId Int
  amenityId Int
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, amenityId])
  @@index([productId])
  @@index([amenityId])
}

/// Core booking record — ties a customer to a product for a duration.
model Booking {
  id              Int           @id @default(autoincrement())
  bookingNumber   String        @unique
  customerId      Int
  productId       Int
  durationTypeId  Int
  statusId        Int
  startDate       DateTime
  endDate         DateTime
  startTime       String?
  endTime         String?
  durationUnits   Int           @default(1)
  unitPrice       Decimal       @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  taxRate         Decimal?      @db.Decimal(5, 2)
  taxAmount       Decimal?      @db.Decimal(10, 2)
  grandTotal      Decimal       @db.Decimal(12, 2)
  securityDeposit Decimal?      @db.Decimal(10, 2)
  depositReturned Boolean       @default(false)
  seats           Int           @default(1)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        Customer      @relation(fields: [customerId], references: [id])
  durationType    DurationType  @relation(fields: [durationTypeId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
  status          BookingStatus @relation(fields: [statusId], references: [id])
  payments        Payment[]

  @@index([customerId])
  @@index([productId])
  @@index([statusId])
  @@index([startDate, endDate])
  @@index([bookingNumber])
  @@index([durationTypeId], map: "Booking_durationTypeId_fkey")
}

/// Payment records against bookings (supports partial payments, deposits, refunds).
model Payment {
  id               Int           @id @default(autoincrement())
  paymentNumber    String        @unique
  bookingId        Int
  statusId         Int
  amount           Decimal       @db.Decimal(12, 2)
  method           String?
  gatewayOrderId   String?
  gatewayPaymentId String?
  currency         String        @default("INR")
  transactionRef   String?
  type             String        @default("PAYMENT")
  notes            String?       @db.Text
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  booking          Booking       @relation(fields: [bookingId], references: [id])
  status           PaymentStatus @relation(fields: [statusId], references: [id])

  @@index([bookingId])
  @@index([statusId])
}

model SupportTicket {
  id           Int                @id @default(autoincrement())
  ticketNumber String             @unique
  customerId   Int?
  assigneeId   Int?
  statusId     Int
  name         String
  email        String?
  phone        String?
  organization String?
  spaceType    String? // Deprecated: use productTypeId
  location     String? // Deprecated: use locationId
  productTypeId Int?
  locationId   Int?
  category     String?
  subCategory  String?
  description  String             @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  assignee     User?              @relation("TicketAssignee", fields: [assigneeId], references: [id])
  customer     Customer?          @relation(fields: [customerId], references: [id])
  status       TicketStatus       @relation(fields: [statusId], references: [id])
  productType  ProductType?       @relation(fields: [productTypeId], references: [id])
  locationRel  Location?          @relation(fields: [locationId], references: [id])
  attachments  TicketAttachment[]

  @@index([customerId])
  @@index([assigneeId])
  @@index([statusId])
  @@index([productTypeId])
  @@index([locationId])
  @@index([ticketNumber])
}

model TicketAttachment {
  id              Int           @id @default(autoincrement())
  supportTicketId Int
  url             String
  fileName        String?
  fileSize        Int?
  mimeType        String?
  createdAt       DateTime      @default(now())
  supportTicket   SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)

  @@index([supportTicketId])
}

/// Tracks all admin actions for accountability and debugging.
model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  module    String
  recordId  Int?
  oldData   String?  @db.LongText
  newData   String?  @db.LongText
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

/// Global settings the admin can tweak without redeployment.
model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text
  group String @default("general")

  @@index([group])
}
